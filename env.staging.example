# Staging / Render backend (parallel to production Supabase)
# Copy values into a Vercel Staging project or run: npm run dev:staging
#
# PRODUCTION: leave NEXT_PUBLIC_USE_BACKEND_API unset or false.

NEXT_PUBLIC_USE_BACKEND_API=true
USE_BACKEND_API=true
API_BASE_URL=https://icaremc-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://icaremc-backend.onrender.com

# Optional: keep Supabase vars for hybrid pages that still need storage.
# Staging mode gates unsupported UI and proxies matching /api/admin/* calls.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
